import org.vosk.Model;
import org.vosk.Recognizer;
import javax.sound.sampled.*;
import java.awt.*;
import java.awt.event.*;
import java.awt.image.BufferedImage;
import java.net.*;
import java.io.*;
import java.util.*;
import java.util.List;
import org.json.*;

public class Main {

    // ── Estado global ──────────────────────────────────────────────
    static Process processoFala       = null;
    static volatile boolean parar     = false;
    static volatile boolean ativo     = false;   // Jarvis está "acordado"?
    static volatile long    ultimaFala = 0;       // timestamp da última fala reconhecida
    static final int TIMEOUT_MS       = 15_000;  // 15s sem falar → dorme

    // Histórico de conversa para a IA
    static List<JSONObject> historico = new ArrayList<>();
    static final int MAX_HISTORICO    = 10; // máximo de turnos lembrados

    // Palavras que ativam o Jarvis
    static final List<String> PALAVRAS_ATIVACAO = List.of(
        "ei jarvis", "ei james", "jarvis", "james", "jardim", "jardins", "computador"
    );

    // ── Fala ──────────────────────────────────────────────────────
    public static void falar(String texto) throws Exception {
        parar  = false;
        texto  = texto.replace("'", "");

        String script =
            "Add-Type -AssemblyName System.Speech; " +
            "$s = New-Object System.Speech.Synthesis.SpeechSynthesizer; " +
            "$s.SelectVoice('Microsoft Maria Desktop'); " +
            "$s.Speak('" + texto + "');";

        processoFala = new ProcessBuilder("powershell", "-Command", script).start();

        while (processoFala.isAlive()) {
            if (parar) { processoFala.destroyForcibly(); break; }
            Thread.sleep(100);
        }
    }

    public static void pararFala() {
        parar = true;
        if (processoFala != null && processoFala.isAlive()) {
            processoFala.destroyForcibly();
            System.out.println("Fala interrompida.");
        }
    }

    // ── IA com histórico ──────────────────────────────────────────
    public static String perguntarIA(String pergunta) throws Exception {

        // Adiciona a pergunta do usuário ao histórico
        JSONObject msgUsuario = new JSONObject();
        msgUsuario.put("role", "user");
        msgUsuario.put("content", pergunta);
        historico.add(msgUsuario);

        // Mantém só os últimos MAX_HISTORICO turnos
        while (historico.size() > MAX_HISTORICO * 2) {
            historico.remove(0);
        }

        // Monta o payload — usa /api/chat do Ollama (suporta histórico)
        JSONObject payload = new JSONObject();
        payload.put("model", "phi3:mini");
        payload.put("stream", false);

        JSONArray msgs = new JSONArray();

        // System prompt — personalidade do Jarvis
        JSONObject sistema = new JSONObject();
        sistema.put("role", "system");
        sistema.put("content",
            "Você é o Jarvis, assistente pessoal do usuário. " +
            "Responda de forma curta, direta e em português brasileiro. " +
            "Seja prestativo e levemente bem-humorado. " +
            "Lembre-se do contexto da conversa."
        );
        msgs.put(sistema);

        for (JSONObject m : historico) msgs.put(m);
        payload.put("messages", msgs);

        // Requisição
        URL url = new URL("http://localhost:11434/api/chat");
        HttpURLConnection con = (HttpURLConnection) url.openConnection();
        con.setRequestMethod("POST");
        con.setRequestProperty("Content-Type", "application/json");
        con.setDoOutput(true);
        con.setConnectTimeout(5000);
        con.setReadTimeout(60000);

        try (OutputStream os = con.getOutputStream()) {
            os.write(payload.toString().getBytes("utf-8"));
        }

        BufferedReader br = new BufferedReader(
            new InputStreamReader(con.getInputStream(), "utf-8"));
        StringBuilder sb = new StringBuilder();
        String linha;
        while ((linha = br.readLine()) != null) sb.append(linha);

        JSONObject resposta = new JSONObject(sb.toString());
        String textoResposta = resposta
            .getJSONObject("message")
            .getString("content")
            .replace("\\n", " ")
            .trim();

        // Salva resposta no histórico
        JSONObject msgJarvis = new JSONObject();
        msgJarvis.put("role", "assistant");
        msgJarvis.put("content", textoResposta);
        historico.add(msgJarvis);

        return textoResposta;
    }

    // ── Ativação / Desativação ────────────────────────────────────
    static void acordar() throws Exception {
        if (!ativo) {
            ativo = true;
            ultimaFala = System.currentTimeMillis();
            System.out.println("[Jarvis] Acordei!");
            falar("Sim, pode falar.");
        }
    }

    static void dormir() throws Exception {
        if (ativo) {
            ativo = false;
            System.out.println("[Jarvis] Dormindo...");
            falar("Ok, estou aqui se precisar.");
        }
    }

    // ── Comandos rápidos ──────────────────────────────────────────
    // Retorna true se reconheceu um comando, false se deve passar pra IA
    static boolean tentarComando(String cmd) throws Exception {

        if (cmd.contains("parar") || cmd.contains("cala boca")) {
            pararFala(); return true;
        }
        if (cmd.contains("dormir") || cmd.contains("pode ir") || cmd.contains("valeu jarvis")) {
            dormir(); return true;
        }
        if (cmd.contains("limpar histórico") || cmd.contains("esquece tudo")) {
            historico.clear();
            falar("Histórico apagado."); return true;
        }
        if (cmd.contains("youtube") || cmd.contains("outubro")) {
            falar("Abrindo o YouTube.");
            new ProcessBuilder("cmd", "/c", "start", "https://youtube.com").start(); return true;
        }
        if (cmd.contains("google")) {
            falar("Abrindo o Google.");
            new ProcessBuilder("cmd", "/c", "start", "https://google.com").start(); return true;
        }
        if (cmd.contains("chat") || cmd.contains("chatgpt")) {
            falar("Abrindo o ChatGPT.");
            new ProcessBuilder("cmd", "/c", "start", "https://chatgpt.com/").start(); return true;
        }
        if (cmd.contains("calculadora")) {
            falar("Beleza.");
            new ProcessBuilder("cmd", "/c", "start", "calc").start(); return true;
        }
        if (cmd.contains("programar") || cmd.contains("vs code")) {
            falar("Hora de codar!");
            new ProcessBuilder("powershell", "-Command",
                "Start-Process 'C:\\Users\\gusta\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe'").start();
            return true;
        }
        if (cmd.contains("java") || cmd.contains("eclipse")) {
            falar("Hora de codar!");
            new ProcessBuilder("powershell", "-Command",
                "Start-Process 'C:\\Users\\gusta\\eclipse\\java-2025-09\\eclipse\\eclipse.exe'").start();
            return true;
        }
        if (cmd.contains("jogos")) {
            falar("Vai jogar o quê?");
            new ProcessBuilder("explorer.exe", "C:\\Users\\gusta\\Desktop\\,").start(); return true;
        }
        if (cmd.contains("spotify") || cmd.contains("esporte") || cmd.contains("música")) {
            falar("Abrindo o Spotify.");
            new ProcessBuilder("C:/Users/gusta/AppData/Roaming/Spotify/Spotify.exe").start(); return true;
        }
        if (cmd.contains("valor") || cmd.contains("valorante")) {
            falar("Esse jogo de novo...");
            new ProcessBuilder("powershell", "-Command",
                "Start-Process 'C:/Riot Games/Riot Client/RiotClientServices.exe'").start(); return true;
        }
        if (cmd.contains("discord")) {
            falar("Beleza.");
            new ProcessBuilder("C:/Users/gusta/AppData/Local/Discord/Update.exe",
                "--processStart", "Discord.exe").start(); return true;
        }
        if (cmd.contains("desligar")) {
            falar("Desligando em 30 segundos.");
            new ProcessBuilder("cmd", "/c", "shutdown /s /t 30").start(); return true;
        }
        if (cmd.contains("reiniciar")) {
            falar("Reiniciando em 30 segundos.");
            new ProcessBuilder("cmd", "/c", "shutdown /r /t 30").start(); return true;
        }
        if (cmd.contains("cancelar")) {
            falar("Cancelado.");
            new ProcessBuilder("cmd", "/c", "shutdown /a").start(); return true;
        }
        if (cmd.contains("fechar tudo") || cmd.contains("limpar tela")) {
            falar("Fechando a bagunça.");
            String[] apps = {
                "EALauncher.exe","brave.exe","wallpaper64.exe",
                "steam.exe","steamwebhelper.exe","TranslucentTB.exe",
                "sqlceip.exe","sqlservr.exe"
            };
            for (String app : apps) {
                try { new ProcessBuilder("taskkill","/F","/IM",app,"/T").start(); }
                catch (Exception ignored) {}
            }
            return true;
        }

        return false; // nenhum comando reconhecido → vai pra IA
    }

    // ── Processamento principal ───────────────────────────────────
    public static void processar(String texto) {

        System.out.println("Reconhecido: " + texto);

        // 1. Verifica palavra de ativação
        boolean temAtivacao = PALAVRAS_ATIVACAO.stream().anyMatch(texto::contains);

        if (!ativo) {
            if (temAtivacao) {
                try { acordar(); } catch (Exception e) { e.printStackTrace(); }
            }
            // Se não está ativo e não tem ativação, ignora
            return;
        }

        // 2. Está ativo — atualiza timestamp
        ultimaFala = System.currentTimeMillis();

        // Remove a palavra de ativação do comando
        String cmd = texto;
        for (String p : PALAVRAS_ATIVACAO) cmd = cmd.replace(p, "").trim();

        if (cmd.isEmpty()) return; // só chamou, sem pedir nada ainda

        // 3. Tenta comando rápido
        try {
            boolean foiComando = tentarComando(cmd);

            // 4. Se não foi comando, manda pra IA
            if (!foiComando) {
                final String pergunta = cmd;
                new Thread(() -> {
                    try {
                        falar("Deixa eu pensar...");
                        String resposta = perguntarIA(pergunta);
                        System.out.println("IA: " + resposta);
                        if (!parar) falar(resposta);
                    } catch (Exception e) {
                        System.out.println("Erro IA: " + e.getMessage());
                    }
                }).start();
            }

        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    // ── Main ──────────────────────────────────────────────────────
    public static void main(String[] args) throws Exception {

        // Bandeja
        if (!SystemTray.isSupported()) { System.out.println("SystemTray não suportado."); return; }

        BufferedImage image = new BufferedImage(16, 16, BufferedImage.TYPE_INT_RGB);
        Graphics2D g = image.createGraphics();
        g.setColor(Color.CYAN); g.fillOval(0, 0, 16, 16); g.dispose();

        PopupMenu menu = new PopupMenu();
        MenuItem sair = new MenuItem("Sair");
        sair.addActionListener(e -> System.exit(0));
        menu.add(sair);

        TrayIcon trayIcon = new TrayIcon(image, "Jarvis", menu);
        trayIcon.setImageAutoSize(true);
        SystemTray.getSystemTray().add(trayIcon);

        // ── Hotkey Ctrl+J via Robot polling (sem dependência externa) ──
        // OBS: para hotkey global real, adicione a lib JNativeHook
        // Por ora, use a System Tray para ativar/desativar com clique duplo
        trayIcon.addActionListener(e -> {
            try {
                if (ativo) dormir(); else acordar();
            } catch (Exception ex) { ex.printStackTrace(); }
        });

        // Thread de timeout — dorme se ficar muito tempo sem falar
        new Thread(() -> {
            while (true) {
                try {
                    Thread.sleep(2000);
                    if (ativo && System.currentTimeMillis() - ultimaFala > TIMEOUT_MS) {
                        System.out.println("[Jarvis] Timeout — dormindo.");
                        dormir();
                    }
                } catch (Exception ignored) {}
            }
        }).start();

        falar("Jarvis iniciado. Me chame quando precisar.");
        trayIcon.displayMessage("Jarvis", "Diga 'Ei Jarvis' para ativar", TrayIcon.MessageType.INFO);

        // Modelo e microfone
        Model model = new Model("C:/programacao/JARVIS/JARVIS/model/vosk-model-small-pt-0.3");
        Recognizer rec = new Recognizer(model, 16000);

        TargetDataLine mic = AudioSystem.getTargetDataLine(
            new AudioFormat(16000, 16, 1, true, false));
        mic.open(); mic.start();

        byte[] buffer = new byte[4096];

        while (true) {
            int bytesRead = mic.read(buffer, 0, buffer.length);

            if (rec.acceptWaveForm(buffer, bytesRead)) {
                String resultado = rec.getResult();
                String texto = resultado
                    .replace("{\"text\":\"", "")
                    .replace("\"}", "")
                    .trim()
                    .toLowerCase();

                if (!texto.isEmpty()) processar(texto);
            }

            Thread.sleep(20);
        }
    }
}